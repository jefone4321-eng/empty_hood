{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <h1>Products</h1>
        <a href="#" class="admin-btn-primary">
            <i class="fa-solid fa-plus"></i> Add Product
        </a>
    </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Collection</th>
                <th>Actions</th>
            </tr>
            {% for product in products %}
                <tr>
                    <td><img src="/{{ product.image }}" class="admin-thumb" alt="{{ product.name }}"></td>
                    <td>{{ product.name }}</td>
                    <td>₱{{ product.price|number_format(2) }}</td>
                    <td>{{ product.category }}</td>
                    <td>{{ product.collection }}</td>
                    <td>
                        <a href="#">Edit</a>
                        <form method="post" action="#" onsubmit="return confirm('Delete this product?');" style="display:inline">
                            <input type="hidden" name="id" value="{{ product.id }}">
                            <button type="submit" class="admin-delete-btn">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No products yet.</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}