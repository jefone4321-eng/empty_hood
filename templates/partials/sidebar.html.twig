            </li>
            <li>
                <a href="{{ path('app_inventory_history') }}" class="{{ route == 'app_inventory_history' ? 'active' : '' }}">
                    <i class="fa-solid fa-clock-rotate-left"></i><span>Inventory History</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>