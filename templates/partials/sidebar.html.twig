{% set route = app.request.attributes.get('_route') %}

<aside class="admin-sidebar">
    <div class="admin-sidebar-brand">My App</div>

    <nav>
        <ul>
            <li>
                <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' : '' }}">
                    <i class="fa-solid fa-gauge-high"></i><span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_products') }}" class="{{ route == 'app_products' ? 'active' : '' }}">
                    <i class="fa-solid fa-shirt"></i><span>Products</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_accounts') }}" class="{{ route == 'app_accounts' ? 'active' : '' }}">
                    <i class="fa-solid fa-users"></i><span>Accounts</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_reviews') }}" class="{{ route == 'app_reviews' ? 'active' : '' }}">
                    <i class="fa-solid fa-star"></i><span>Reviews</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_inventory') }}" class="{{ route == 'app_inventory' ? 'active' : '' }}">
                    <i class="fa-solid fa-boxes-stacked"></i><span>Inventory</span>
                </a>
