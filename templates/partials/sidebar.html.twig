{% set current = app.current_route|default('') %}

<aside class="admin-sidebar">
    <div class="admin-sidebar-brand">Admin Dashboard</div>

    <ul>
        {% if is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_dashboard') }}" class="{{ current == 'app_dashboard' ? 'active' : '' }}">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>
            </li>
        {% endif %}

        <li>
            <a href="{{ path('app_product_index') }}" class="{{ current starts with 'app_product' ? 'active' : '' }}">
                <i class="fa-solid fa-shirt"></i> Products
            </a>
        </li>
        <li>
            <a href="{{ path('app_category_index') }}" class="{{ current starts with 'app_category' ? 'active' : '' }}">
                <i class="fa-solid fa-tags"></i> Categories
            </a>
        </li>

        {% if is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_user_index') }}" class="{{ current starts with 'app_user' ? 'active' : '' }}">
                    <i class="fa-solid fa-users"></i> Accounts
                </a>
            </li>
        {% endif %}

        <li>
            <a href="{{ path('app_profile') }}" class="{{ current starts with 'app_profile' ? 'active' : '' }}">
                <i class="fa-solid fa-user"></i> My Profile
            </a>
        </li>
        <li>
            <a href="{{ path('app_logout') }}">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </li>
    </ul>
</aside>