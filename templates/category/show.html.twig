{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <h1>{{ category.name }}</h1>
        <div>
            <a href="{{ path('app_category_index') }}" class="admin-btn-primary">Back to list</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="admin-btn-primary" style="margin-left:8px;">Edit</a>
            {% endif %}
        </div>
    </div>

    <div class="admin-table-wrapper" style="max-width:640px;">
        <table class="admin-table">
            <tbody>
                <tr><th>Name</th><td>{{ category.name }}</td></tr>
                <tr><th>Slug</th><td>{{ category.slug }}</td></tr>
                <tr><th>Description</th><td>{{ category.description ?: '-' }}</td></tr>
            </tbody>
        </table>
    </div>
{% endblock %}