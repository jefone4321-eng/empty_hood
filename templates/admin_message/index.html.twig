{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
    <h1>Messages</h1>
    <p style="color:#888; margin-bottom:24px;">Submissions from the Contact Us form.</p>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Message</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
            {% for msg in messages %}
                <tr>
                    <td>{{ msg.name }}</td>
                    <td><a href="mailto:{{ msg.email }}">{{ msg.email }}</a></td>
                    <td style="max-width:320px; white-space:pre-wrap;">{{ msg.message }}</td>
                    <td>{{ msg.submitted_at|date('M j, Y g:i A') }}</td>
                    <td>
                        <form method="post" action="#" onsubmit="return confirm('Delete this message?');" style="display:inline">
                            <input type="hidden" name="id" value="{{ msg.id }}">
                            <button type="submit" class="admin-delete-btn">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="admin-empty">No messages yet.</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}